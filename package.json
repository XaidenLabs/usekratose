{
  "name": "usekratose",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @usekratose/web dev",
    "dev:monitor": "pnpm --filter @usekratose/monitor dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @usekratose/database migrate",
    "proof:upgrade": "pnpm --filter @usekratose/monitor proof:upgrade",
    "security:diff": "pnpm --filter @usekratose/monitor security:diff",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23"
    }
  }
}
